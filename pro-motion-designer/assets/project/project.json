{
  "name": "my-product-film",
  "width": 1920,
  "height": 1080,
  "fps": 60,
  "duration": 8,
  "bpm": 120,
  "music": {
    "file": "audio/music.mp3",
    "start": 0,
    "fade_out": 1.2,
    "bed_db": -3
  },
  "sfx": {
    "type": "audio/sfx_typing.wav",
    "whoosh": "audio/sfx_whoosh.wav",
    "click": "audio/sfx_click.wav",
    "pop": "audio/sfx_pop.wav",
    "chime": "audio/sfx_chime.wav",
    "impact": "audio/sfx_impact.wav"
  },
  "sfx_balance": {
    "_comment": "dB each sound sits over the music around its peak, and absolute [min, max] gain limits",
    "whoosh": [3, -26, -2],
    "impact": [5, -14, 0],
    "click": [3, -18, 0],
    "chime": [3, -20, -2],
    "pop": [-3, -28, -8],
    "type": [-4, -30, -10]
  },
  "loudness": { "lufs": -14, "true_peak": -1 },
  "brand_lint": {
    "_comment": "words the brand never uses on screen (from the brief's don'ts), matched case-insensitively",
    "banned": [],
    "allow_exclamation": false
  }
}
